# Mira Environment Setup
# Copy to .env (server auto-loads ~/.mira/mira.env as well — see scripts/serve-local.sh).
# Every value below is optional; sane defaults are built in. Never commit real secrets.

# ── Server ────────────────────────────────────────────────────────────────
HOST=127.0.0.1                     # loopback by default; use 0.0.0.0 behind a tunnel
PORT=4096
NODE_ENV=development
MIRA_DB=./data/mira.db             # SQLite path; pgvector for learning/memory via DATABASE_URL
# MIRA_GIT_SHA=                      # build-time commit stamp (CI sets it automatically)

# ── Auth ───────────────────────────────────────────────────────────────────
# Single-tenant Bearer token (all requests = implicit owner)
MIRA_TOKEN=change-me-to-a-long-random-secret
# Multi-tenant API keys: credential:owner pairs. Sessions are stamped with an
# ownerID; all session routes + WS events enforce ownership (foreign → 404).
# MIRA_API_KEYS=key-alice:alice,key-bob:bob
# MIRA_STRICT_AUTH=1                 # reject any request without an owner (dev hardening)
# MIRA_TRUST_PROXY=1                 # trust X-Forwarded-* headers (behind reverse proxy)
# MIRA_MAX_BODY_BYTES=1048576        # request body cap

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated Origins allowlist for browser clients + WS upgrades.
# Empty = allow all (dev only).
# CORS_ORIGINS=https://your-pages-site.github.io
# MIRA_STRICT_CORS=1                 # reject unknown origins (fail closed)
# MIRA_ALLOW_LOCALHOST=0             # disable localhost allowance when strict CORS on

# ── Model Gateway (OpenAI-compatible; any of these enable live responses) ───
# MIRA_MODEL=openrouter/anthropic/claude-sonnet-4
# MIRA_SMALL_MODEL=openrouter/deepseek/deepseek-v3.2-exp
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# NVIDIA_API_KEY=nvapi-...

# ── Agentic loop & safety nets ────────────────────────────────────────────
# MIRA_MAX_STEPS=32                  # max LLM turns per prompt
# MIRA_CONTEXT_LIMIT=128000          # tokens before compaction
# MIRA_COMPACTION_THRESHOLD=0.8
# MIRA_READ_GUARD=1                  # require read-before-edit (default on; 0 disables)
# MIRA_DOOM_THRESHOLD=5              # repeated identical tool calls before doom-loop guard
# MIRA_DOOM_WINDOW=30               # observations window for doom-loop detection

# ── Interactive terminal (WS /terminal) ───────────────────────────────────
# MIRA_TERMINAL_ENABLED=1            # set 0 to hard-disable
# MIRA_TERMINAL_SANDBOX=1            # enforce allowedCommands allowlist (from mira.json tools.terminal)
# Note: mira.json → tools.terminal.enabled/sandbox/allowedCommands/timeoutMs
# apply live from config (Settings → Terminal); env vars take precedence when set.

# ── Vision & inline autocomplete ──────────────────────────────────────────
# MIRA_VISION_MODEL=nvidia/meta/llama-3.2-90b-vision-instruct
# MIRA_AUTOCOMPLETE=1                # set 0 to disable /complete + /autocomplete routes
# MIRA_AUTOCOMPLETE_MODEL=

# ── Learning / self-improvement ───────────────────────────────────────────
# FIRECRAWL_API_KEY=                 # best quality web search + scrape
# TAVILY_API_KEY=                    # fallback search
# Without either, online learning is disabled (no fabricated results).
# MIRA_EVAL_GATE=1                   # PR eval tier must pass before synthesized patches apply
# MIRA_AUTOPILOT=1                   # enable autopilot patch loop
# MIRA_SHADOW_RUN_TESTS=1            # run shadow tests on generated patches
# MIRA_JUDGE_MODEL=                  # LLM-as-judge model for nightly evals
# MIRA_JUDGE_MODE=                   # judge grading mode
# MIRA_VACUUM=1                      # DB vacuum on schedule

# ── Observability (optional) ──────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com
# MIRA_OTEL_METRICS_URL=             # metrics backend for prod error-rate eval
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── LSP tool overrides ────────────────────────────────────────────────────
# MIRA_LSP_GO_CMD=gopls
# MIRA_LSP_TS_CMD=typescript-language-server --stdio
# MIRA_LSP_PY_CMD=pylsp
# MIRA_LSP_RS_CMD=rust-analyzer

# ── Slack bot (packages/slack) ────────────────────────────────────────────
# MIRA_API_URL=http://127.0.0.1:4096
# MIRA_API_KEY=your-issued-96-hex-key  # or MIRA_TOKEN
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# MIRA_SLACK_AGENT=code
# MIRA_SLACK_STRICT=0                # 1 = only respond to explicit mentions

# ── Client / web dev ───────────────────────────────────────────────────────
# CLI & TUI clients read MIRA_API_URL (default http://127.0.0.1:4096).
# VITE_API_URL=                    # baked into the web build (Pages sets this in CI)
# VITE_MIRA_TOKEN=                 # DEV ONLY — token fallback for the web dev server
# MIRA_DEV_API=http://127.0.0.1:4096  # full URL override for vite dev proxy
# MIRA_DEV_PORT=4096               # dev-proxy target port when MIRA_DEV_API not set
# MIRA_WEB_PORT=3000               # web dev server port
# MIRA_TUI_PORT=3001               # tui dev server port
# MIRA_HMR_HOST=localhost          # HMR websocket host (remote dev → your domain)

# ── Misc ──────────────────────────────────────────────────────────────────
# MIRA_APIURL=                     # legacy alias for MIRA_API_URL (CLI compat)
# DATABASE_URL=                    # Postgres+pgvector for production memory/knowledge
