# Mira Production Environment Example
# Copy to .env and fill values. Never commit real secrets.

# Server
HOST=0.0.0.0
PORT=4096
MIRA_DB=./data/mira.db
# Single-tenant bearer token (all requests = implicit "default" owner)
MIRA_TOKEN=change-me-to-a-long-random-secret
# Multi-tenant API keys: credential:owner pairs. Sessions are stamped with an
# ownerID; all session routes + WS events enforce ownership (foreign → 404).
# When set, this supersedes single-token mode for issued keys.
# MIRA_API_KEYS=key-alice:alice,key-bob:bob

# CORS allowlist for browser clients + WS Origin check (comma-separated).
# Empty = allow all origins (dev only).
# CORS_ORIGINS=https://mira.example.com

# Agentic loop limits (also settable in mira.json under "loop")
# MIRA_MAX_STEPS=32
# MIRA_CONTEXT_LIMIT=128000
# MIRA_COMPACTION_THRESHOLD=0.8
# MIRA_SMALL_MODEL=openrouter/deepseek/deepseek-v3.2-exp

# Self-improvement promotion gate: runEval("pr") must pass before a
# synthesized patch is applied (fail-closed). Off by default.
# MIRA_EVAL_GATE=1

# Model Gateway
OPENROUTER_API_KEY=sk-or-...
NVIDIA_API_KEY=nvapi-...
# Optional: other providers via gateway config

# Vision / Search
MIRA_VISION_MODEL=nvidia/meta/llama-3.2-90b-vision-instruct
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# LSP
MIRA_LSP_GO_CMD=gopls

# Autopilot / CI
MIRA_AUTOPILOT=0

# Slack bot (packages/slack — Socket Mode, no tunnel)
# MIRA_API_URL=http://127.0.0.1:4096
# MIRA_API_KEY=your-96-hex-issued-key-owner-slack-team
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Logging
LOG_LEVEL=info
