# Mira Staging Environment Setup
# Copy to .env.staging — values for staging deploy.
# Do NOT commit real secrets. Use CI secret injection.

# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4096
NODE_ENV=staging
MIRA_DB=./data/mira.db
MIRA_GIT_SHA=

# ── Auth ───────────────────────────────────────────────────────────────────
# MIRA_TOKEN set via CI secret for staging
MIRA_API_KEYS=
MIRA_STRICT_AUTH=1
MIRA_TRUST_PROXY=1
MIRA_MAX_BODY_BYTES=1048576

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://staging.mira.example.com,https://app.staging.mira.example.com
MIRA_STRICT_CORS=1
MIRA_ALLOW_LOCALHOST=0

# ── Model Gateway ────────────────────────────────────────────
MIRA_MODEL=openrouter/anthropic/claude-sonnet-4
MIRA_SMALL_MODEL=openrouter/deepseek/deepseek-v3.2-exp
# API keys injected via CI secrets
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# NVIDIA_API_KEY=nvapi-...

# ── Agentic loop & safety nets ────────────────────────────────────────────
MIRA_MAX_STEPS=32
MIRA_CONTEXT_LIMIT=128000
MIRA_COMPACTION_THRESHOLD=0.8
MIRA_READ_GUARD=1
MIRA_DOOM_THRESHOLD=5
MIRA_DOOM_WINDOW=30

# ── Interactive terminal ───────────────────────────────────
MIRA_TERMINAL_ENABLED=1
MIRA_TERMINAL_SANDBOX=1

# ── Learning / self-improvement ───────────────────────────────────────────
# FIRECRAWL_API_KEY=...
# TAVILY_API_KEY=...
MIRA_EVAL_GATE=1
MIRA_AUTOPILOT=0
MIRA_SHADOW_RUN_TESTS=1

# ── Observability ─────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
MIRA_OTEL_METRICS_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Client / web ───────────────────────────────────────────────────────
VITE_API_URL=https://staging-api.mira.example.com
MIRA_DEV_API=https://staging-api.mira.example.com
MIRA_WEB_PORT=3000

# ── Misc ──────────────────────────────────────────────────────────────────
DATABASE_URL=
