{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping Mira's /metrics",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "uid": "mira-overview",
  "title": "Mira Server Overview",
  "description": "Golden signals for a Mira server instance: traffic, latency, sessions, LLM spend. Scrape target exposes /metrics (unauthenticated by default).",
  "tags": ["mira", "agent-server"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(http_requests_total, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Traffic",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by status class",
      "description": "req/s grouped into 2xx / 4xx / 5xx. Sustained 4xx may be auth failures; any 5xx deserves investigation.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "axisPlacement": "auto" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "5.." },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineWidth", "value": 3 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "4.." },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (status_class) (label_replace(rate(http_requests_total{instance=~\"$instance\"}[5m]), \"status_class\", \"${1}xx\", \"status\", \"([245])..\"))",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Top routes by request rate",
           "description": "Top 8 busiest routes (method + route label).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(8, sum by (method, route) (rate(http_requests_total{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Latency & load",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Average request latency",
      "description": "Mean over the window (summary metric: _sum / _count). SSE prompt streams dominate this — expect elevated averages when agents are running.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 16, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 2 }, { "color": "red", "value": 10 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_sum{instance=~\"$instance\"}[5m])) / sum(rate(http_request_duration_seconds_count{instance=~\"$instance\"}[5m]))",
          "legendFormat": "avg latency"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active sessions",
      "description": "In-memory gauge: sessions created minus deleted since process start. Resets on restart.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 4, "x": 16, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }, { "color": "orange", "value": 20 }] } },
        "overrides": []
      },
      "targets": [{ "expr": "max(active_sessions{instance=~\"$instance\"})", "legendFormat": "active" }]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Error ratio (5xx)",
      "description": "Share of requests returning 5xx over 5m.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 4, "x": 20, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{instance=~\"$instance\", status=~\"5..\"}[5m])) / sum(rate(http_requests_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "LLM spend",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Gateway cost (cumulative)",
      "description": "Total USD spent via the model gateway since process start.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 50 }] }
        },
        "overrides": []
      },
      "targets": [{ "expr": "max(gateway_cost_total{instance=~\"$instance\"})", "legendFormat": "spend" }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Spend rate",
      "description": "USD/hour burn over the window — alert on spikes (runaway agents).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "derivative(max(gateway_cost_total{instance=~\"$instance\"})[10m:1m]) * 3600",
          "legendFormat": "usd/hour"
        }
      ]
    }
  ],
  "annotations": { "list": [] },
  "links": []
}
