{
  "name": "mira",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "prepare": "husky || true",
    "dev": "bunx turbo dev --continue --filter=!@mira/slack",
    "dev:all": "turbo dev --continue",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "eslint . || true",
    "deps:install": "scripts/install.sh",
    "deps:check": "node scripts/verify-install.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.11.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.3.0",
    "playwright": "^1.63.0",
    "prettier": "^3.4.0",
    "turbo": "^2.11.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "escape-string-regexp": "^5.0.0",
    "find-up": "^8.0.0",
    "locate-path": "^8.0.0",
    "supports-color": "^11.0.0",
    "undici": "^8.12.3"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.3",
    "seroval": "^1.6.9",
    "seroval-plugins": "^1.6.9"
  }
}