{
  "name": "mira",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "turbo dev --continue --filter=!@mira/slack",
    "dev:all": "turbo dev --continue",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.3.0",
    "playwright": "^1.63.0",
    "prettier": "^3.4.0",
    "turbo": "2.11.2",
    "typescript": "5.9.3"
  }
}
