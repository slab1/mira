{
  "_comment": "Nvidia is primary (auto-pick): nemotron-3.5-lightning-30b-a3b for default/agent, nemotron-3.5-bolt-e4b for cheap/compaction, nemotron-3-ultra-550b-a55b for reasoning. Health at GET /gateway/health, cost caps per lane.",
  "model": "nvidia/nvidia/nemotron-3.5-lightning-30b-a3b",
  "loop": {
    "maxSteps": 32,
    "contextLimit": 128000,
    "compactionThreshold": 0.8,
    "smallModel": "nvidia/nvidia/nemotron-3.5-bolt-e4b"
  },
  "provider": {
    "openrouter": {
      "name": "OpenRouter",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {}
    },
    "anthropic": {
      "name": "Anthropic Direct",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://api.anthropic.com/v1",
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "models": {
        "claude-sonnet-4": {
          "name": "Claude Sonnet 4",
          "limit": { "context": 200000, "output": 8192 }
        }
      }
    },
    "openai": {
      "name": "OpenAI",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://api.openai.com/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": { "context": 128000, "output": 4096 }
        }
      }
    },
    "google": {
      "npm": "@ai-sdk/google",
      "name": "Google Generative AI",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta",
        "apiKey": "{env:GOOGLE_API_KEY}",
        "timeout": 120000,
        "kind": "google"
      },
      "models": {}
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "timeout": 120000,
        "kind": "deepseek"
      },
      "models": {}
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}",
        "timeout": 120000,
        "kind": "nvidia"
      },
      "models": {}
    },
    "colibri": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Colibri Local (MoE streamed from disk)",
      "comment": "Pure C, zero deps — run frontier MoE locally: https://github.com/JustVugg/colibri — needs COLI_MODEL=... ./coli serve --port 8000",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "{env:COLI_API_KEY}",
        "timeout": 180000,
        "kind": "colibri"
      },
      "models": {
        "qwen3.6": { "name": "Qwen3.6 35B-A3B (20GB, recommended)", "limit": { "context": 32768, "output": 4096 } },
        "olmoe": { "name": "OLMoE 7B (8GB, fastest)", "limit": { "context": 4096, "output": 2048 } },
        "glm-5.2": { "name": "GLM-5.2 744B MoE (372GB)", "limit": { "context": 131072, "output": 8192 } }
      }
    }
  },
  "mcp": {
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
      }
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp",
      "enabled": false
    }
  },
  "routing": {
    "aliases": {},
    "fallbacks": [
      "nvidia/nvidia/nemotron-3.5-bolt-e4b",
      "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
      "anthropic/claude-sonnet-4",
      "openai/gpt-4o"
    ],
    "defaultProvider": "nvidia"
  },
  "features": {
    "injectTodosIntoLoadContext": true,
    "enforceLaneContracts": true,
    "perAgentPermissionProfiles": true
  },
  "tools": {
    "terminal": {
      "enabled": true,
      "sandbox": true,
      "timeoutMs": 30000
    }
  }
}
