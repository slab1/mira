{
  "name": "@mira/server",
  "version": "0.1.0",
  "description": "Mira agent engine - SessionPrompt.loop, Tool Registry, Event Bus, Model Gateway",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc --noEmit && bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "eval": "bun src/eval/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/storage/migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@hono/zod-validator": "^0.7.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.26.0",
    "ai": "^5.0.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "js-tiktoken": "^1.0.21",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "drizzle-kit": "^0.31.0",
    "bun-types": "1.4.0",
    "@types/ws": "^8.5.0",
    "@types/bun": "1.4.0"
  }
}