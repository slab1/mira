{
  "$schema": "https://mira.dev/schema/config.v1.json",
  "version": 1,
  "default_model": "anthropic/claude-3-7-sonnet",
  "providers": {
    "anthropic": {
      "apiKey": "{env:ANTHROPIC_API_KEY}"
    },
    "openai": {
      "apiKey": "{env:OPENAI_API_KEY}"
    },
    "gemini": {
      "apiKey": "{env:GEMINI_API_KEY}"
    },
    "nvidia": {
      "apiKey": "{env:NVIDIA_API_KEY}"
    }
  }
}
