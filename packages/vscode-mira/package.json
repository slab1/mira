{
  "name": "vscode-mira",
  "displayName": "Mira",
  "description": "VS Code extension for Mira agent workspace",
  "version": "0.0.1",
  "engines": { "vscode": "^1.99.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "mira.hello", "title": "Mira: Hello" },
      { "command": "mira.openWeb", "title": "Mira: Open Web Panel" },
      { "command": "mira.createSession", "title": "Mira: Create Session" },
      { "command": "mira.listSessions", "title": "Mira: List Sessions" },
      { "command": "mira.setToken", "title": "Mira: Set API Token" },
      { "command": "mira.openTerminal", "title": "Mira: Open Terminal (PTY)" },
      { "command": "mira.openChat", "title": "Mira: Open Chat" },
      { "command": "mira.toggleAutocomplete", "title": "Mira: Toggle Autocomplete" }
    ],
    "configuration": {
      "title": "Mira",
      "properties": {
        "mira.apiUrl": { "type": "string", "default": "http://127.0.0.1:4096", "description": "Mira server URL" },
        "mira.model": { "type": "string", "default": "openrouter/anthropic/claude-sonnet-4", "description": "Default model for new sessions" },
        "mira.autocomplete": { "type": "boolean", "default": true, "description": "Enable inline autocomplete (ghost-text) via Mira gateway (Kilo K4)" },
        "mira.autocompleteModel": { "type": "string", "default": "", "description": "Model for autocomplete (default: server smallModel; e.g. openrouter/deepseek/deepseek-v3.2-exp)" }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.8.0"
  }
}
