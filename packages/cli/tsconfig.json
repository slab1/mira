{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "preserveSymlinks": true,
    "types": ["bun-types"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "../shared/src/**/*"]
}
